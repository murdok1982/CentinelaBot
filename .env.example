# ===========================================
# CentinelaBot v2.0 - Configuracion
# ===========================================

# --- Flask ---
FLASK_SECRET_KEY=cambiar-en-produccion
FLASK_ENV=development
FLASK_PORT=5000

# --- JWT ---
JWT_SECRET=jwt-cambiar-en-produccion
JWT_EXPIRATION_HOURS=24

# --- Base de Datos ---
DATABASE_URL=sqlite:///centinela.db

# --- IA ---
AI_PROVIDER=ollama
OPENAI_API_KEY=
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Email (SMTP) ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# --- Telegram ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- SIEM ---
SYSLOG_HOST=
SYSLOG_PORT=514
